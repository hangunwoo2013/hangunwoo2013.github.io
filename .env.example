# B-ROUTE 2.0.0-beta.2 local / Cloud Run server-side configuration.
# Never commit .env or put a server secret in HTML/browser code.

APP_ENV=development
APP_VERSION=2.0.0-beta.2
APP_ORIGIN=http://127.0.0.1:8080
# Additional exact frontend origins for split hosting. Semicolon-separated; never use *.
APP_ALLOWED_ORIGINS=
# Use "none" only for HTTPS cross-site browser sessions; same-origin uses the default lax.
SESSION_COOKIE_SAMESITE=lax
APP_TIMEZONE=Asia/Seoul
PORT=8080
DATA_DIR=./data
DATABASE_PATH=./data/broute.sqlite3
# Production must use a durable PostgreSQL service.
DATABASE_URL=
SESSION_SECRET=
BETA_RELEASE_APPROVED=false

# Transactional project invitation emails (server-only). Use a Resend sending key
# and an address on a domain verified in Resend.
RESEND_API_KEY=
INVITE_FROM_EMAIL=
# Resend requires a sender address on a domain verified in Resend.
# The business Gmail below is Reply-To/contact only; do not use it as Resend From.
INVITE_REPLY_TO_EMAIL=broute.site.app@gmail.com
INVITE_FROM_NAME=B-ROUTE
# Resend webhook signing secret (whsec_...). Configure external endpoint /api/webhooks/resend (the API is mounted under /api).
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE_SECONDS=300
# App-level safety cap; current Resend Free pricing lists 3,000/month and 100/day.
# B-ROUTE caps itself at 80/day; other apps in the same Resend team share provider quota.
INVITE_EMAIL_DAILY_LIMIT=80

# Global owner can only be a Google identity. Prefer the stable Google OIDC sub.
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_SUB=
GOOGLE_ADMIN_EMAIL=

# Naver OIDC (profile email is not treated as a verified identity claim).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://127.0.0.1:8080/api/auth/naver/callback

# Microsoft Identity Platform: common supports personal and organizational accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8080/api/auth/microsoft/callback

# Public transport APIs; all credentials remain on the server.
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_API_KEY=
TAGO_TRAIN_SERVICE_NAME=TrainInfo
DATA_GO_REQUEST_TIMEOUT_SECONDS=15
PROVIDER_RATE_LIMIT_PER_MINUTE=60

# Tencent COS private bucket. Required for cloud files / large GTFS staging.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_SESSION_TOKEN=
GTFS_STAGING_MAX_BYTES=2147483648
GTFS_STAGING_PART_SIZE_MB=16
GTFS_WORKER_MAX_UNCOMPRESSED_BYTES=4294967296
GTFS_WORKER_BATCH_ROWS=5000
GTFS_WORKER_POLL_SECONDS=15
GTFS_WORKER_MAX_MEMBER_BYTES=3221225472
GTFS_WORKER_HEARTBEAT_TTL_SECONDS=120
GTFS_WORKER_ID=
